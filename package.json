{
  "name": "peacock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4545",
    "build": "next build",
    "start": "next start -p 4545",
    "lint": "eslint",
    "db:setup": "psql \"$DATABASE_URL\" -f sql/001_init.sql",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "psql \"$DATABASE_URL\" -f sql/999_reset.sql && npm run db:setup",
    "db:local": "node scripts/localdb.mjs start",
    "db:local:stop": "node scripts/localdb.mjs stop"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "nanoid": "^5.1.16",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
